{
  "name": "server",
  "version": "1.0.0",
  "main": "src/server.ts",
  "scripts": {
    "dev": "cd server && ts-node-dev -P tsconfig.json --respawn --transpile-only src/server.ts",
    "dev:client": "cd client && npm run dev",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:client\"",
    "build": "react-scripts build"
  },
  "dependencies": {
    "@mui/material": "^9.0.0",
    "@reduxjs/toolkit": "^2.12.0",
    "axios": "^1.15.2",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "icons": "^1.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.4.1",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.14.2",
    "serverless-http": "^4.0.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "ts-node-dev": "^2.0.0"
  }
}
